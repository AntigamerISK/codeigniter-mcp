{
  "name": "codeigniter-mcp",
  "version": "0.1.1",
  "description": "MCP (Model Context Protocol) server that accelerates development of a custom PHP framework inspired by CodeIgniter: MVC + optional Services/Repository layer. Scaffolds controllers, services, repositories, entities, migrations and tests; validates routes and lints against framework conventions.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "codeigniter-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.12.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ci": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepack": "npm run build",
    "inspector": "npx @modelcontextprotocol/inspector node dist/index.js"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "codeigniter",
    "php",
    "scaffolding",
    "framework",
    "mvc",
    "claude",
    "llm"
  ],
  "license": "MIT",
  "author": {
    "name": "AntigamerISK",
    "url": "https://github.com/AntigamerISK"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AntigamerISK/codeigniter-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/AntigamerISK/codeigniter-mcp/issues"
  },
  "homepage": "https://github.com/AntigamerISK/codeigniter-mcp#readme",
  "sideEffects": false,
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0",
    "vitest": "^4.1.10"
  }
}
